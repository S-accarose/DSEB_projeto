@model IEnumerable<DSEB_projeto.Models.Pedido>
@{
    var usuarios = ViewBag.Usuarios as List<DSEB_projeto.Models.Usuario>;
}
<div class="container">
    <H1 class="text-custom">Pedidos</H1>
</div>

<style>
    .card-pedido {
        min-width: none;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px;
        margin-bottom: 10px;
        background-color: #7474749c;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .info {
        font-weight: bold;
        color: rgb(19, 32, 49);
    }
</style>

<h1>@ViewData["Title"]</h1>

<div class="container-lg">
    <div class="row">
        @if (User.IsInRole("Admin"))
        {
            <ul>
                @foreach (var user in usuarios)
                {
                    <div class="card-pedido" style="margin: 2vh 0 1vh 0;">
                        <div class="info">@user.Nome (@user.Email)</div>
                        <a asp-action="Pedidos" asp-route-usuarioId="@user.Id">Ver pedidos</a>
                    </div>

                }
            </ul>

        }
        else
        {
            @if (!Model.Any())
            {
                <div class="col-12">
                    <p>Nenhum pedido encontrado.</p>
                </div>
            }
            else
            {
                @foreach (var pedido in Model)
                {
                    <div class="col-12 mb-2">
                        <div class="pedido d-flex flex-wrap align-items-center border rounded p-2">
                            <span class="me-3"><strong class="info">Pedido número:</strong> <span
                                    class="text-custom">@pedido.Id</span></span>
                            <span class="me-3"><strong class="info">Descrição:</strong> <span
                                    class="text-custom">@pedido.Descricao</span></span>
                            <span class="me-3"><strong class="info">Data do pedido:</strong> <span
                                    class="text-custom">@pedido.DataPedido.ToString("dd/MM/yyyy")</span></span>
                            <button type="button" class="btn btn-primary apagar-pedido" data-id="@pedido.Id">Apagar
                            Pedido</button>        
                        </div>
                    </div>
                }
            }

        }

    </div>
</div>
<script>
    document.querySelectorAll('.apagar-pedido').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                const pedidoId = btn.getAttribute('data-id');
                if (confirm('Tem certeza que deseja apagar este serviço?')) {
                    const response = await fetch(`/Pedidos/Delete/${pedidoId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    });
                    if (response.ok) {
                        alert('Serviço apagado com sucesso!');
                        location.reload();
                    } else {
                        alert('Erro ao apagar serviço.');
                    }
                }
            });
        });
</script>