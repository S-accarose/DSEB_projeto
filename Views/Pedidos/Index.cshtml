@model IEnumerable<DSEB_projeto.Models.Pedido>
@{
    var usuarios = ViewBag.Usuarios as List<DSEB_projeto.Models.Usuario>;     
}
@{
    ViewData["Title"] = "Pedidos";
}


<h1>@ViewData["Title"]</h1>

<div class="container-lg">
    <div class="row">
        @if (User.IsInRole("Admin"))
        {
            <ul>
            @foreach (var user in usuarios)
            {                
                    <li>@user.Nome (@user.Email)</li>
                    <a asp-action="Pedidos" asp-route-usuarioId="@user.Id">Ver pedidos</a>
            }
            </ul>

        }
        else
        {
            @if (!Model.Any())
            {
                <div class="col-12">
                    <p>Nenhum pedido encontrado.</p>
                </div>
            }
            else
            {
                @foreach (var pedido in Model)
                {
                    <div class="col-12 mb-2">
                        <div class="pedido d-flex flex-wrap align-items-center border rounded p-2">
                            <span class="me-3"><strong>Pedido número:</strong> @pedido.Id</span>
                            <span class="me-3"><strong>Descrição:</strong> @pedido.Descricao</span>
                            <span class="me-3"><strong>Data do pedido:</strong> @pedido.DataPedido.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                }
            }

        }

    </div>
</div>