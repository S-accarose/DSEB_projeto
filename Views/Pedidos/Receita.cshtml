@model IEnumerable<DSEB_projeto.Models.Pedido>
@using Pedido = DSEB_projeto.Models.Pedido

<style>
    .card-pedido {
        min-width: none;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px;
        margin-bottom: 10px;
        background-color: #7474749c;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .info{
        font-weight: bold;
        color: rgb(19, 32, 49);
    }
</style>

<div class="container"><h1 class="text-custom">Pedidos de @ViewBag.Usuario.Nome (@ViewBag.Usuario.Email)</h1></div>

<div class="container">
    @foreach(var pedido in Model)
    {
        <div class="card-pedido" style="margin: 2vh 0 1vh 0;">
            <div class="info">
                Pedido número: @pedido.Id - @pedido.Descricao - @pedido.DataPedido.ToString("dd/MM/yyyy")
            </div>
            <button type="button" class="btn btn-primary apagar-pedido" data-id="@pedido.Id">Apagar
                            Pedido</button>
        </div>
    }
    <div class="valorfinal">
        <h3 class="text-custom">Total do valor gerado nos pedidos: @ViewBag.ValorTotal.ToString("C")</h3>
    </div>
</div>
<script>
    document.querySelectorAll('.apagar-pedido').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                const pedidoId = btn.getAttribute('data-id');
                if (confirm('Tem certeza que deseja apagar este serviço?')) {
                    const response = await fetch(`/Pedidos/Delete/${pedidoId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    });
                    if (response.ok) {
                        alert('Serviço apagado com sucesso!');
                        location.reload();
                    } else {
                        alert('Erro ao apagar serviço.');
                    }
                }
            });
        });
</script>



