@{
    ViewData["Title"] = "Informações do Usuário";
}

<h1>@ViewData["Title"]</h1>

<div class="container mt-4">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Detalhes do Usuário</h5>
            <dl class="row">
                <dt class="col-sm-3">Nome de Usuário:</dt>
                <dd class="col-sm-9">@ViewBag.UserName</dd>

                <dt class="col-sm-3">Nome:</dt>
                <dd class="col-sm-9">@ViewBag.Nome</dd>

                <dt class="col-sm-3">Funções (Roles):</dt>
                <dd class="col-sm-9">
                    @if (ViewBag.Roles != null && ViewBag.Roles.Count > 0)
                    {
                        foreach (var role in ViewBag.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }
                    }
                    else
                    {
                        <span>Nenhuma função atribuída</span>
                    }
                </dd>

                <dt class="col-sm-3">É Administrador?</dt>
                <dd class="col-sm-9">
                    @if (ViewBag.IsAdmin)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Não</span>
                    }
                </dd>

                <dt class="col-sm-3">Claims:</dt>
                <dd class="col-sm-9">
                    @if (ViewBag.Claims != null && ViewBag.Claims.Count > 0)
                    {
                        <ul class="list-unstyled">
                            @foreach (var claim in ViewBag.Claims)
                            {
                                <li><strong>@claim.Type:</strong> @claim.Value</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>Nenhuma claim adicional</span>
                    }
                </dd>
            </dl>
        </div>
    </div>
</div>
