@model IEnumerable<DSEB_projeto.Models.Servico>

<div class="container" style="margin: 5vh 0 0 0;">
    <div class="row">
        @foreach (var servico in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card" style="min-height: 17rem; width: 100%;">
                    <div class="tituloservico" style="margin: 10px 0 0 15px;">@servico.Nome</div>
                    <img src="@(!string.IsNullOrEmpty(servico.ImagemUrl) ? servico.ImagemUrl : 
                                                                                                        !string.IsNullOrEmpty(servico.ImagemString) ? servico.ImagemString : 
                                                                                                        "/images/default.jpg")"
                        style="height: 14vh; width:90%; margin: 2% 5% 0 5%;" alt="Imagem do serviço"
                        onerror="this.onerror=null; this.src='/images/default.jpg';">
                    <div class="card-body">
                        <p class="card-text descricao">@servico.Descricao</p>
                        <h6>Valores fixos: 200R$ Contratação do serviço + 350R$ Funcionários.</h6>
                        <h5 class="preco" data-valor="@servico.Preco">Valor: @servico.Preco.ToString("C")</h5>
                        @if (!User.IsInRole("Admin"))
                        {
                            <div class="mb-3">
                                <label class="form-label">Número de convidados:</label>
                                <input type="number" class="form-control numConvidados" min="10" value="10" max="100"
                                    data-preco="@servico.Preco" />
                            </div>

                            <button type="button" class="btn btn-primary solicitar-servico" data-id="@servico.Id">Solicitar
                                Serviço</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary apagar-servico" data-id="@servico.Id">Apagar
                                Serviço</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="container mb-3">
        <a class="btn btn-primary" asp-action="Create">Criar Novo Serviço</a>
    </div>

}

@section Scripts {
    <script>
        document.querySelectorAll('.numConvidados').forEach(function (input) {
            input.addEventListener('input', function () {
                const preco = parseFloat(this.getAttribute('data-preco'));
                const num = parseInt(this.value) || 1;
                const valorTotal = preco * num;
                this.closest('.card-body').querySelector('.preco').innerText = "Valor por pessoa: " + valorTotal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            });
        });

        document.querySelectorAll('.solicitar-servico').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                const card = btn.closest('.card');
                const servicoId = btn.getAttribute('data-id');
                const convidados = card.querySelector('.numConvidados').value;

                const formData = new URLSearchParams();
                formData.append('servicoId', servicoId);
                formData.append('convidados', convidados);

                const response = await fetch('/Pedidos/CriarPedido', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: formData
                });

                if (response.ok) {
                    const data = await response.json();
                    alert('Pedido realizado com sucesso! Número do pedido: ' + data.pedidoId);
                } else {
                    alert('Erro ao realizar pedido. Faça login ou tente novamente.');
                }
            });
        });
        document.querySelectorAll('.apagar-servico').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                const servicoId = btn.getAttribute('data-id');
                if (confirm('Tem certeza que deseja apagar este serviço?')) {
                    const response = await fetch(`/Servicos/Delete/${servicoId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    });
                    if (response.ok) {
                        alert('Serviço apagado com sucesso!');
                        location.reload();
                    } else {
                        alert('Erro ao apagar serviço.');
                    }
                }
            });
        });
        document.querySelectorAll('.numConvidados').forEach(function (input) {
            input.addEventListener('change', function () {
                let num = parseInt(this.value) || 10;
                if (num < 10) num = 10;
                if (num > 100) num = 100;
                this.value = num;
                const preco = parseFloat(this.getAttribute('data-preco'));
                const valorTotal = preco * num;
                this.closest('.card-body').querySelector('.preco').innerText = "Valor por pessoa: " + valorTotal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            });
        });
    </script>
}